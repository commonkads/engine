{
  "name": "@commonkads/engine",
  "version": "0.1.0",
  "description": "Core PSM runtime — PSM templates, engine loop, and provider interfaces",
  "type": "module",
  "author": "Rob Proper",
  "license": "Apache-2.0",
  "keywords": [],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run compile && npm run test:ci",
    "prebuild": "npm run lint -- --fix",
    "build": "npm run compile",
    "precompile": "npm run lint:fix",
    "compile": "tsc --build && tsc --noEmit -p tsconfig.test.json",
    "precompile:clean": "npm audit && rm -rf ./dist",
    "compile:clean": "npm run compile -- --clean",
    "format": "prettier \"./**/*.ts\" --write",
    "lint:fix": "npm run lint -- --fix",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "postlint": "npm run format",
    "prerepackage": "rm -rf dist",
    "repackage": "npm audit --audit-level=high && npm run compile && npm run test:ci && npm run package",
    "package": "npm pack --pack-destination dist/",
    "package:publish": "npm publish dist/*.tgz",
    "package:published": "mkdir -p ./published && tar xf dist/*.tgz -C ./published/",
    "test": "node --no-warnings --import tsx/esm --test $(find src -name '*.test.ts' | sort)",
    "test:ci": "node --no-warnings --import tsx/esm --test-reporter spec --test-reporter-destination stdout --test-reporter junit --test-reporter-destination test-results.xml --test $(find src -name '*.test.ts' | sort)",
    "test:integration": "node --no-warnings --import tsx/esm --test $(find src -name '*.test.integration.ts' | sort)",
    "version:pr": "echo \"$(npm run version:current -s)-alpha-$(date +'%Y%m%d%H%M%S')\"",
    "version:current": "node -p \"require('./package.json').version\"",
    "watch": "npm run compile -- --watch",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commonkads/knowledge-examples": "1.0.0",
    "@eslint/js": "^9.39.5",
    "@robproper/feature-workflow": "latest",
    "@types/debug": "^4.1.12",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "debug": "^4.4.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@robproper/feature-workflow": true,
    "esbuild@0.28.2": true
  }
}
